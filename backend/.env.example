DATABASE_URL="postgresql://user:password@localhost:5432/nightlife_pos"
PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h

# MMQR — APlus (Ayeyarwady Farmer Development Bank)
# UAT base URL:  https://merchant-thirdparty-api-uat.abdev.net/acquiring-qr-service
# PROD base URL: https://merchant-thirdparty-api.apluswallet.com.mm/acquiring-qr-service
MMQR_API_URL=
MMQR_MERCHANT_ID=        # Merchant ID issued by ABank (e.g. MA0001789)
MMQR_SECRET_KEY=         # secretKey header value (skpwd)
MMQR_ECCODE=             # eccode header value (e.g. wbIfbxxxxxxxxxxxx==)

# Callback URLs registered with ABank — both can point to the same endpoint.
# Register these with ABank as your success and failure callback URLs:
#   Success: {MMQR_CALLBACK_BASE_URL}/callback
#   Failure: {MMQR_CALLBACK_BASE_URL}/callback
MMQR_CALLBACK_BASE_URL=  # e.g. https://your-api.railway.app/api/payments

# Telegram Bot
TELEGRAM_BOT_TOKEN=

LOG_LEVEL=info
